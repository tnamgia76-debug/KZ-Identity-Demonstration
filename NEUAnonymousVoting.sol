pragma solidity ^0.8.23;

import "@semaphore-protocol/contracts/interfaces/ISemaphore.sol";
import "@semaphore-protocol/contracts/interfaces/ISemaphoreGroups.sol";

contract NEUAnonymousVoting {

    // Main Semaphore interface:
    // create group, add members, validate proof.
    ISemaphore public semaphore;

    // Group-reading interface:
    // read root, size and depth.
    ISemaphoreGroups public semaphoreGroups;

    // ID of our Semaphore group.
    uint256 public groupId;

    // Simple voting result.
    uint256 public yesVotes;
    uint256 public noVotes;


    // --------------------------------------------------
    // CONSTRUCTOR
    // --------------------------------------------------

    constructor(address semaphoreAddress) {

        // Both interfaces point to the SAME Semaphore contract.
        semaphore = ISemaphore(semaphoreAddress);
        semaphoreGroups = ISemaphoreGroups(semaphoreAddress);

        // This voting contract becomes group admin.
        groupId = semaphore.createGroup(address(this));
    }


    // --------------------------------------------------
    // ADD MEMBER
    // --------------------------------------------------

    function addMember(
        uint256 identityCommitment
    ) external {

        semaphore.addMember(
            groupId,
            identityCommitment
        );
    }


    // --------------------------------------------------
    // READ GROUP INFORMATION
    // --------------------------------------------------

    function getGroupRoot()
        external
        view
        returns (uint256)
    {
        return semaphoreGroups.getMerkleTreeRoot(groupId);
    }


    function getGroupSize()
        external
        view
        returns (uint256)
    {
        return semaphoreGroups.getMerkleTreeSize(groupId);
    }


    function getGroupDepth()
        external
        view
        returns (uint256)
    {
        return semaphoreGroups.getMerkleTreeDepth(groupId);
    }


    // --------------------------------------------------
    // VOTE
    //
    // message:
    // 1 = YES
    // 0 = NO
    // --------------------------------------------------

    function vote(
        uint256 merkleTreeDepth,
        uint256 merkleTreeRoot,
        uint256 nullifier,
        uint256 message,
        uint256 scope,
        uint256[8] calldata points
    ) external {

        // Reconstruct the Semaphore proof
        // generated by our local Node.js demo.
        ISemaphore.SemaphoreProof memory proof =
            ISemaphore.SemaphoreProof({
                merkleTreeDepth: merkleTreeDepth,
                merkleTreeRoot: merkleTreeRoot,
                nullifier: nullifier,
                message: message,
                scope: scope,
                points: points
            });


        // Semaphore checks:
        //
        // 1. proof is cryptographically valid
        // 2. Merkle root belongs to this group
        // 3. member belongs to the group
        // 4. nullifier has NOT been used before
        //
        // If something is wrong -> transaction reverts.
        semaphore.validateProof(
            groupId,
            proof
        );


        // Only executed if the proof is valid.
        if (message == 1) {

            yesVotes += 1;

        } else if (message == 0) {

            noVotes += 1;
        }
    }
}